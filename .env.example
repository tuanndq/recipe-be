# App
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# MySQL (api + docker-compose mysql service)
MYSQL_ROOT_PASSWORD=root_secret
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=recipe
DB_PASSWORD=recipe_secret
DB_DATABASE=recipe_db
DB_SYNC=false

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
STORAGE_DRIVER=local
IMAGE_CONVERT_TO_WEBP=true
WEBP_QUALITY=80

# S3 (when STORAGE_DRIVER=s3)
AWS_REGION=ap-southeast-1
S3_BUCKET=your-bucket-name
S3_PREFIX=recipes
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_KEY_PREFIX=recipe-api

# Rate limit
THROTTLE_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
